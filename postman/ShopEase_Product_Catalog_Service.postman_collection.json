      "key": "base_url",
      "value": "http://localhost:8005"
    },
    {
      "key": "access_token",
      "value": "PASTE_CUSTOMER_ACCESS_TOKEN"
    },
    {
      "key": "admin_token",
      "value": "PASTE_ADMIN_ACCESS_TOKEN"
    }
  ],
