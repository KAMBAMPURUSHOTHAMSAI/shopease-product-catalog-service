APP_NAME=ShopEase Product Catalog Service
APP_VERSION=1.0.0
APP_PORT=8005
DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=shopease_product_catalog_db
DB_USER=shopease_catalog_user
DB_PASSWORD=replace-with-a-strong-catalog-db-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Copy the exact JWT_SECRET_KEY from shopease-auth-service/.env. Never commit it.
JWT_SECRET_KEY=replace-with-the-exact-auth-service-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=shopease-auth-service
LOW_STOCK_THRESHOLD=5
